ANTHROPIC_API_KEY=
# Opcional: overridea el modelo por defecto (claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=
# URL del Worker de remote-mcp-server ya desplegado, ej. https://<nombre>.<subdominio>.workers.dev/mcp
REMOTE_MCP_URL=
# Opcional: ruta absoluta a mcp-design-system-server/app/server.py. Default: asume que
# ese repo está clonado como sibling de este (../mcp-design-system-server/app/server.py).
# DESIGN_SYSTEM_SERVER_PATH=

# Servidores MCP de compañeros (funcionalidad #6). Defaults asumen que están clonados en
# chatbot-host/external-mcps/<repo>/ (ver README, sección Usage).
# Ruta al binario ya compilado de restaurant-mcp-server (go build -o bin/restaurant-mcp-server ./cmd/server)
# RESTAURANT_MCP_SERVER_PATH=
# Ruta a la raíz del repo mcp_f1_strategy (con uv ya instalado y `uv sync` corrido)
# F1_MCP_SERVER_PATH=
